# Copy this file's contents into Railway's "Variables" tab for this service.
# (Don't commit a real .env file with real secrets to GitHub.)

# From the ServiceM8 Developer Portal, on your add-on's page
SM8_APP_ID=your-app-id
SM8_APP_SECRET=your-app-secret

# Space-separated OAuth scopes this add-on needs.
# read_jobs / read_customers = read job + client details to prefill the form
# publish_job_notes = post the completed order into the job diary
SM8_OAUTH_SCOPE=read_jobs read_customers publish_job_notes

# The public URL Railway gives this service, e.g. https://jsj-order-addon.up.railway.app
# (no trailing slash). Update this after your first deploy, once Railway shows you the URL.
PUBLIC_BASE_URL=https://your-app-name.up.railway.app

# Where the connected account's OAuth tokens get stored. If you attach a
# Railway Volume, mount it at /data and leave this as-is so tokens survive
# redeploys. Otherwise tokens will be lost on every redeploy and you'll need
# to reconnect (visit /oauth/start again) each time.
TOKENS_FILE=/data/tokens.json
